# .env.example — copy to .env.local and fill in values
DATABASE_URL=postgresql://deskrpg:deskrpg_dev_pw@localhost:5437/deskrpg
JWT_SECRET=change-me-to-a-random-64-char-string
DESKRPG_IMAGE=dandacompany/deskrpg:latest
OPENCLAW_IMAGE=deskrpg-openclaw:latest
OPENCLAW_TOKEN=change-me-openclaw-token
OPENCLAW_MODEL=openai-codex/gpt-5.4

# Cookie security: set to "true" for HTTPS deployments, "false" for HTTP/localhost
# COOKIE_SECURE=false

# Optional: Disable public registration (invite-only mode)
# REGISTRATION_DISABLED=true
# NEXT_PUBLIC_REGISTRATION_DISABLED=true

# Optional: SQLite mode (no PostgreSQL needed)
# DB_TYPE=sqlite
# SQLITE_PATH=data/deskrpg.db

# ── Storage (channel attachments) ─────────────────────────────────────
# Driver: "local" (default) writes to $DESKRPG_HOME/uploads/attachments,
# "s3" uses any S3-compatible store (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# STORAGE_DRIVER=local

# Override the local upload root (defaults to $DESKRPG_HOME/uploads/attachments)
# STORAGE_LOCAL_DIR=

# Per-channel total storage cap (default 5 GiB). Set 0 to disable.
# STORAGE_CHANNEL_QUOTA_BYTES=5368709120
# Per-file size cap (default 100 MiB).
# STORAGE_FILE_MAX_BYTES=104857600

# ── Storage S3 (only when STORAGE_DRIVER=s3) ──────────────────────────
# S3_ENDPOINT leave blank for AWS, set for R2 (https://<acct>.r2.cloudflarestorage.com),
# B2 (https://s3.<region>.backblazeb2.com), or MinIO (http://minio:9000).
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=deskrpg-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style URLs are required by MinIO and most non-AWS providers.
# S3_FORCE_PATH_STYLE=true
# Optional public CDN base for unsigned reads (skip signed-URL roundtrip).
# S3_PUBLIC_BASE_URL=

# ── Realtime media (LiveKit) ──────────────────────────────────────────
# Configure both URL and credentials to enable voice/video/screen-share.
# Self-host: see docker/docker-compose.livekit.yml. Cloud: use your project URL.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=change-me-to-a-random-64-char-string
# Public URL exposed to browsers (defaults to LIVEKIT_URL when not set).
# NEXT_PUBLIC_LIVEKIT_URL=
